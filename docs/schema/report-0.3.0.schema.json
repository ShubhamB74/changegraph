{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/changegraph/report-0.3.0.schema.json",
  "title": "ChangeGraph report 0.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "repository",
    "comparison",
    "changed_files",
    "discovery",
    "graph",
    "impact",
    "warnings",
    "execution"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "head_commit"
      ],
      "properties": {
        "root": {
          "type": "string"
        },
        "head_commit": {
          "type": "string"
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "base",
        "target",
        "base_commit",
        "target_commit",
        "merge_base_commit"
      ],
      "properties": {
        "mode": {
          "enum": [
            "merge_base",
            "working_tree"
          ]
        },
        "base": {
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "base_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "merge_base_commit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/changed_file"
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_files",
        "source_files",
        "test_files",
        "exclude_patterns"
      ],
      "properties": {
        "total_files": {
          "type": "integer",
          "minimum": 0
        },
        "source_files": {
          "type": "integer",
          "minimum": 0
        },
        "test_files": {
          "type": "integer",
          "minimum": 0
        },
        "exclude_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "graph": {
      "$ref": "#/$defs/graph"
    },
    "impact": {
      "$ref": "#/$defs/impact"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "enum": [
              "walk_error",
              "dirty_working_tree",
              "parse_error",
              "read_error",
              "tsconfig_issue",
              "graph_target_mismatch",
              "impact_depth_limited",
              "impact_uncertainty",
              "unmodeled_config_change"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_ms"
      ],
      "properties": {
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "changed_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status",
        "category",
        "excluded"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "old_path": {
          "type": "string"
        },
        "status": {
          "enum": [
            "added",
            "modified",
            "deleted",
            "renamed",
            "copied",
            "type_changed",
            "unmerged",
            "untracked"
          ]
        },
        "category": {
          "enum": [
            "source",
            "test",
            "other"
          ]
        },
        "excluded": {
          "type": "boolean"
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_semantics",
        "nodes",
        "edges",
        "external_dependencies",
        "unresolved_imports",
        "cycles",
        "stats"
      ],
      "properties": {
        "edge_semantics": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "category",
              "parse_status"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "category": {
                "enum": [
                  "source",
                  "test"
                ]
              },
              "parse_status": {
                "enum": [
                  "ok",
                  "partial",
                  "failed"
                ]
              },
              "exports": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "kind",
              "type_only",
              "specifier",
              "line"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "import",
                  "re_export",
                  "re_export_all"
                ]
              },
              "type_only": {
                "type": "boolean"
              },
              "specifier": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "external_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "package",
              "specifier",
              "kind",
              "type_only",
              "line"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "package": {
                "type": "string"
              },
              "specifier": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "import",
                  "re_export",
                  "re_export_all"
                ]
              },
              "type_only": {
                "type": "boolean"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "unresolved_imports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "specifier",
              "reason",
              "kind",
              "type_only",
              "line"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "specifier": {
                "type": "string"
              },
              "reason": {
                "enum": [
                  "not_found",
                  "outside_repository",
                  "unsupported_file_type",
                  "absolute_path"
                ]
              },
              "kind": {
                "enum": [
                  "import",
                  "re_export",
                  "re_export_all"
                ]
              },
              "type_only": {
                "type": "boolean"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "cycles": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "stats": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "files",
            "edges",
            "external_dependencies",
            "unresolved_imports",
            "parsed_ok",
            "parsed_partial",
            "parsed_failed",
            "cycle_count"
          ],
          "properties": {
            "files": {
              "type": "integer",
              "minimum": 0
            },
            "edges": {
              "type": "integer",
              "minimum": 0
            },
            "external_dependencies": {
              "type": "integer",
              "minimum": 0
            },
            "unresolved_imports": {
              "type": "integer",
              "minimum": 0
            },
            "parsed_ok": {
              "type": "integer",
              "minimum": 0
            },
            "parsed_partial": {
              "type": "integer",
              "minimum": 0
            },
            "parsed_failed": {
              "type": "integer",
              "minimum": 0
            },
            "cycle_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_depth",
        "depth_limited",
        "ordering",
        "changed",
        "affected",
        "uncertain",
        "ignored_changed_files",
        "summary"
      ],
      "properties": {
        "max_depth": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "depth_limited": {
          "type": "boolean"
        },
        "ordering": {
          "type": "string"
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "status",
              "category",
              "kind",
              "direct_dependents",
              "transitive_dependents"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "added",
                  "modified",
                  "deleted",
                  "renamed",
                  "copied",
                  "type_changed",
                  "unmerged",
                  "untracked"
                ]
              },
              "category": {
                "enum": [
                  "source",
                  "test",
                  "other"
                ]
              },
              "kind": {
                "enum": [
                  "present",
                  "deleted",
                  "renamed_from"
                ]
              },
              "direct_dependents": {
                "type": "integer",
                "minimum": 0
              },
              "transitive_dependents": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "affected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rank",
              "path",
              "category",
              "classification",
              "distance",
              "changed_dependency_count",
              "affected_by",
              "path_from_changed",
              "hops",
              "explanation"
            ],
            "properties": {
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "path": {
                "type": "string"
              },
              "category": {
                "enum": [
                  "source",
                  "test",
                  "other"
                ]
              },
              "classification": {
                "enum": [
                  "direct",
                  "transitive"
                ]
              },
              "distance": {
                "type": "integer",
                "minimum": 1
              },
              "changed_dependency_count": {
                "type": "integer",
                "minimum": 1
              },
              "affected_by": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "changed_file",
                    "distance"
                  ],
                  "properties": {
                    "changed_file": {
                      "type": "string"
                    },
                    "distance": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              },
              "path_from_changed": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2
              },
              "hops": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "importer",
                    "imported",
                    "kind",
                    "type_only",
                    "specifier",
                    "line"
                  ],
                  "properties": {
                    "importer": {
                      "type": "string"
                    },
                    "imported": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "import",
                        "re_export",
                        "re_export_all"
                      ]
                    },
                    "type_only": {
                      "type": "boolean"
                    },
                    "specifier": {
                      "type": "string"
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              },
              "explanation": {
                "type": "string"
              }
            }
          }
        },
        "uncertain": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "category",
              "reasons"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "category": {
                "enum": [
                  "source",
                  "test",
                  "other"
                ]
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "unresolved_import",
                        "parse_partial",
                        "parse_failed"
                      ]
                    },
                    "specifier": {
                      "type": "string"
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "minItems": 1
              }
            }
          }
        },
        "ignored_changed_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "reason": {
                "enum": [
                  "non_source_file",
                  "excluded",
                  "not_in_graph"
                ]
              }
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "changed_files",
            "affected",
            "direct",
            "transitive",
            "affected_tests",
            "uncertain"
          ],
          "properties": {
            "changed_files": {
              "type": "integer",
              "minimum": 0
            },
            "affected": {
              "type": "integer",
              "minimum": 0
            },
            "direct": {
              "type": "integer",
              "minimum": 0
            },
            "transitive": {
              "type": "integer",
              "minimum": 0
            },
            "affected_tests": {
              "type": "integer",
              "minimum": 0
            },
            "uncertain": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
