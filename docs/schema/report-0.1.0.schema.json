{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/changegraph/report-0.1.0.schema.json",
  "title": "ChangeGraph report 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "repository", "comparison", "changed_files", "discovery", "warnings", "execution"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "head_commit"],
      "properties": { "root": { "type": "string" }, "head_commit": { "type": "string" } }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "base", "target", "base_commit", "target_commit", "merge_base_commit"],
      "properties": {
        "mode": { "enum": ["merge_base", "working_tree"] },
        "base": { "type": ["string", "null"] },
        "target": { "type": ["string", "null"] },
        "base_commit": { "type": ["string", "null"] },
        "target_commit": { "type": ["string", "null"] },
        "merge_base_commit": { "type": ["string", "null"] }
      }
    },
    "changed_files": { "type": "array", "items": { "$ref": "#/$defs/changed_file" } },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_files", "source_files", "test_files", "exclude_patterns", "files"],
      "properties": {
        "total_files": { "type": "integer", "minimum": 0 },
        "source_files": { "type": "integer", "minimum": 0 },
        "test_files": { "type": "integer", "minimum": 0 },
        "exclude_patterns": { "type": "array", "items": { "type": "string" } },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "category"],
            "properties": {
              "path": { "type": "string" },
              "category": { "enum": ["source", "test"] }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "enum": ["walk_error", "dirty_working_tree"] },
          "message": { "type": "string" }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms"],
      "properties": { "duration_ms": { "type": "integer", "minimum": 0 } }
    }
  },
  "$defs": {
    "changed_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status", "category", "excluded"],
      "properties": {
        "path": { "type": "string" },
        "old_path": { "type": "string" },
        "status": { "enum": ["added", "modified", "deleted", "renamed", "copied", "type_changed", "unmerged", "untracked"] },
        "category": { "enum": ["source", "test", "other"] },
        "excluded": { "type": "boolean" }
      }
    }
  }
}
