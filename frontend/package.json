{
  "name": "changegraph-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive viewer for ChangeGraph JSON reports",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/lib/*.test.ts\"",
    "sync-schema": "node scripts/sync-schema.mjs",
    "sample": "bash scripts/make-sample-report.sh"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.5",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}
